#!/usr/bin/env python3
"""ReadMigraineDiary - turn a scanned/photographed migraine diary page into CSV.

Usage:
    ReadMigraineDiary IMAGE [-o OUTPUT.csv] [--year YYYY] [--no-header]

Writes ``IMAGE`` with its extension replaced by ``.csv``:

    date,migraine,headache,medication
    2026-01-01,no,no,yes
    ...

Exits non-zero (and writes nothing) if the image cannot be confidently
matched to a diary month page.
"""

from __future__ import annotations

import argparse
import csv
import os
import sys

_ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _ROOT)


def _bootstrap() -> None:
    """Re-exec inside the project virtualenv if the deps are not importable."""
    try:
        import cv2  # noqa: F401
        return
    except ImportError:
        pass
    venv = os.path.join(_ROOT, ".venv", "bin", "python3")
    if os.path.exists(venv) and os.path.realpath(venv) != os.path.realpath(sys.executable):
        os.execv(venv, [venv, os.path.abspath(__file__)] + sys.argv[1:])
    raise SystemExit("ReadMigraineDiary: OpenCV is not installed; "
                     "run  pip install -r requirements.txt")


_bootstrap()

from diary import reader  # noqa: E402


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="ReadMigraineDiary",
        description="Convert a photo or scan of a migraine diary month page into CSV.")
    ap.add_argument("image", help="path to the scanned diary page")
    ap.add_argument("-o", "--output", help="output CSV path (default: image path with .csv)")
    ap.add_argument("--year", type=int, help="calendar year for the dates (default: current year)")
    ap.add_argument("--no-header", action="store_true", help="omit the CSV header row")
    ap.add_argument("--quiet", "-q", action="store_true", help="only report errors")
    ap.add_argument("--debug-warp", help="write the rectified page to this path (diagnostics)")
    args = ap.parse_args(argv)

    if not os.path.isfile(args.image):
        print(f"ReadMigraineDiary: no such file: {args.image}", file=sys.stderr)
        return 2

    try:
        result = reader.read(args.image, want_debug=bool(args.debug_warp),
                             year=args.year)
    except Exception as exc:  # unreadable/corrupt file, etc.
        print(f"ReadMigraineDiary: could not process {args.image}: {exc}", file=sys.stderr)
        return 2

    if args.debug_warp and result.warped is not None:
        import cv2

        cv2.imwrite(args.debug_warp, result.warped)

    if not result.ok:
        print(f"ReadMigraineDiary: rejected {os.path.basename(args.image)}: {result.reason}",
              file=sys.stderr)
        return 1

    out = args.output or os.path.splitext(args.image)[0] + ".csv"
    rows = reader.to_rows(result, year=args.year)
    with open(out, "w", newline="") as fh:
        w = csv.writer(fh)
        if not args.no_header:
            w.writerow(["date", "migraine", "headache", "medication"])
        w.writerows(rows)

    if not args.quiet:
        marked = sum(1 for r in rows if "yes" in r[1:])
        diag = result.diagnostics
        print(f"{out}: month {result.month:02d}, {len(rows)} days, {marked} with entries "
              f"(markers {int(diag.get('markers', 0))}/4, "
              f"template match {diag.get('template_score', 0.0):.2f})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
